# Editor defaults, so a file's whitespace does not depend on who opened it.
# `.gitattributes` already forces LF on checkout; this is the other half —
# it stops an editor writing CRLF or tabs into a file in the first place.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,mjs,js,cjs,ts,tsx,json,yml,yaml,toml,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
